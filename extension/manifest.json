{
  "manifest_version": 3,
  "name": "Work Acceptor",
  "version": "0.10.2",
  "description": "Checks your job sites every minute and reports to the local Work Acceptor agent.",
  "permissions": ["alarms", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://kandua-pro.web.app/*",
    "https://insurancesp.standardbank.co.za/*",
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Work Acceptor" }
}
